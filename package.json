{
  "name": "saalankruta-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && vite build --ssr scripts/render.tsx --outDir .prerender && node scripts/prerender.mjs",
    "build:wordpress": "node scripts/build-wordpress.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts tests docs *.md"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@shadergradient/react": "^2.4.20",
    "camera-controls": "^3.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "php-parser": "^3.2.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0"
}
